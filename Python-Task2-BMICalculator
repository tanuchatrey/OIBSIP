from datetime import datetime
import math
import sqlite3
import tkinter as tk
from tkinter import messagebox, ttk

try:
    import matplotlib.pyplot as plt
    MATPLOTLIB_AVAILABLE = True
except ImportError:
    MATPLOTLIB_AVAILABLE = False


class BMIDatabase:
    def __init__(self, db_name="bmi_records.db"):
        self.db_name = db_name
        self.init_db()

    def get_connection(self):
        try:
            conn = sqlite3.connect(self.db_name)
            conn.execute("PRAGMA foreign_keys = ON")
            return conn
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to connect to database:\n{error}"
            )
            return None

    def init_db(self):
        conn = self.get_connection()
        if conn is None:
            return

        try:
            cursor = conn.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL
                )
            """)
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS records (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    date TEXT NOT NULL,
                    weight REAL NOT NULL,
                    height REAL NOT NULL,
                    bmi REAL NOT NULL,
                    category TEXT NOT NULL,
                    FOREIGN KEY (user_id) REFERENCES users(id)
                )
            """)
            conn.commit()
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to initialize database:\n{error}"
            )
        finally:
            conn.close()

    def get_users(self):
        conn = self.get_connection()
        if conn is None:
            return []

        try:
            cursor = conn.cursor()
            cursor.execute("SELECT name FROM users ORDER BY name")
            return [row[0] for row in cursor.fetchall()]
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to read users:\n{error}"
            )
            return []
        finally:
            conn.close()

    def add_user(self, name):
        conn = self.get_connection()
        if conn is None:
            return False

        try:
            cursor = conn.cursor()
            cursor.execute("INSERT OR IGNORE INTO users (name) VALUES (?)", (name,))
            conn.commit()

            if cursor.rowcount == 0:
                messagebox.showinfo(
                    "Existing User",
                    f"{name} already exists. Select the user from the list."
                )
                return False
            return True
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to save user:\n{error}"
            )
            return False
        finally:
            conn.close()

    def save_record(self, username, weight, height, bmi, category):
        conn = self.get_connection()
        if conn is None:
            return False

        try:
            cursor = conn.cursor()
            cursor.execute("SELECT id FROM users WHERE name = ?", (username,))
            user = cursor.fetchone()

            if user is None:
                messagebox.showerror(
                    "Database Error",
                    "User profile was not found. Please add the user again."
                )
                return False

            date_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            cursor.execute("""
                INSERT INTO records
                    (user_id, date, weight, height, bmi, category)
                VALUES (?, ?, ?, ?, ?, ?)
            """, (user[0], date_str, weight, height, bmi, category))

            conn.commit()
            return True
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to save BMI record:\n{error}"
            )
            return False
        finally:
            conn.close()

    def get_history(self, username):
        conn = self.get_connection()
        if conn is None:
            return []

        try:
            cursor = conn.cursor()
            cursor.execute("""
                SELECT date, weight, height, bmi, category
                FROM records
                WHERE user_id = (
                    SELECT id FROM users WHERE name = ?
                )
                ORDER BY id ASC
            """, (username,))
            return cursor.fetchall()
        except sqlite3.Error as error:
            messagebox.showerror(
                "Database Error",
                f"Failed to fetch history:\n{error}"
            )
            return []
        finally:
            conn.close()


class AdvancedBMICalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Advanced BMI Calculator")
        self.root.geometry("720x700")
        self.root.minsize(650, 620)

        self.bg_color = "#f4f6f9"
        self.root.configure(bg=self.bg_color)

        self.db = BMIDatabase()
        self.create_widgets()
        self.load_users()

    def create_widgets(self):
        title_label = tk.Label(
            self.root,
            text="BMI Calculator & Tracker",
            font=("Arial", 20, "bold"),
            bg=self.bg_color,
            fg="#333333"
        )
        title_label.pack(pady=12)

        user_frame = tk.LabelFrame(
            self.root,
            text="User Management",
            font=("Arial", 10, "bold"),
            bg=self.bg_color,
            padx=10,
            pady=10
        )
        user_frame.pack(fill="x", padx=20, pady=5)

        tk.Label(
            user_frame,
            text="Select User:",
            bg=self.bg_color,
            font=("Arial", 10)
        ).grid(row=0, column=0, sticky="w", padx=5)

        self.user_combobox = ttk.Combobox(
            user_frame,
            state="readonly",
            width=22,
            font=("Arial", 10)
        )
        self.user_combobox.grid(row=0, column=1, padx=5)
        self.user_combobox.bind("<<ComboboxSelected>>", self.on_user_select)

        self.new_user_entry = tk.Entry(
            user_frame,
            width=20,
            font=("Arial", 10)
        )
        self.new_user_entry.grid(row=0, column=2, padx=5)
        self.new_user_entry.insert(0, "New User Name")

        tk.Button(
            user_frame,
            text="Add User",
            command=self.handle_add_user,
            bg="#007bff",
            fg="white",
            font=("Arial", 9, "bold")
        ).grid(row=0, column=3, padx=5)

        input_frame = tk.LabelFrame(
            self.root,
            text="Enter Measurements",
            font=("Arial", 10, "bold"),
            bg=self.bg_color,
            padx=10,
            pady=10
        )
        input_frame.pack(fill="x", padx=20, pady=10)

        tk.Label(
            input_frame,
            text="Weight (kg):",
            bg=self.bg_color,
            font=("Arial", 10)
        ).grid(row=0, column=0, sticky="w", pady=8, padx=5)

        self.weight_entry = tk.Entry(
            input_frame,
            font=("Arial", 11),
            width=20
        )
        self.weight_entry.grid(row=0, column=1, pady=8, padx=5)

        tk.Label(
            input_frame,
            text="Height (m):",
            bg=self.bg_color,
            font=("Arial", 10)
        ).grid(row=1, column=0, sticky="w", pady=8, padx=5)

        self.height_entry = tk.Entry(
            input_frame,
            font=("Arial", 11),
            width=20
        )
        self.height_entry.grid(row=1, column=1, pady=8, padx=5)

        tk.Button(
            self.root,
            text="Calculate & Save BMI",
            command=self.calculate_bmi,
            bg="#28a745",
            fg="white",
            font=("Arial", 11, "bold"),
            pady=6
        ).pack(fill="x", padx=20, pady=5)

        result_frame = tk.Frame(
            self.root,
            bg=self.bg_color,
            pady=5
        )
        result_frame.pack(fill="x", padx=20)

        self.result_label = tk.Label(
            result_frame,
            text="BMI: --",
            font=("Arial", 13, "bold"),
            bg=self.bg_color,
            fg="#333333"
        )
        self.result_label.pack(anchor="w")

        self.category_label = tk.Label(
            result_frame,
            text="Category: --",
            font=("Arial", 13, "bold"),
            bg=self.bg_color,
            fg="#333333"
        )
        self.category_label.pack(anchor="w", pady=2)

        history_frame = tk.LabelFrame(
            self.root,
            text="History & Trends",
            font=("Arial", 10, "bold"),
            bg=self.bg_color,
            padx=10,
            pady=10
        )
        history_frame.pack(
            fill="both",
            expand=True,
            padx=20,
            pady=10
        )

        columns = ("Date", "Weight", "Height", "BMI", "Category")
        self.tree = ttk.Treeview(
            history_frame,
            columns=columns,
            show="headings",
            height=7
        )

        widths = {
            "Date": 155,
            "Weight": 90,
            "Height": 90,
            "BMI": 80,
            "Category": 120
        }

        for col in columns:
            self.tree.heading(col, text=col)
            self.tree.column(
                col,
                width=widths[col],
                anchor="center"
            )

        self.tree.pack(fill="both", expand=True, pady=5)

        tk.Button(
            history_frame,
            text="Show Trend Graph",
            command=self.show_trend_graph,
            bg="#17a2b8",
            fg="white",
            font=("Arial", 10, "bold")
        ).pack(fill="x", pady=5)

    def load_users(self):
        users = self.db.get_users()
        self.user_combobox["values"] = users

        if users:
            current = self.user_combobox.get()
            selected = current if current in users else users[0]
            self.user_combobox.set(selected)
            self.update_history_table(selected)
        else:
            self.user_combobox.set("")
            self.update_history_table("")

    def handle_add_user(self):
        name = self.new_user_entry.get().strip()

        if not name or name == "New User Name":
            messagebox.showerror("Input Error", "Please enter a valid user name.")
            return

        if self.db.add_user(name):
            self.load_users()
            self.user_combobox.set(name)
            self.update_history_table(name)
            self.new_user_entry.delete(0, tk.END)

    def on_user_select(self, event=None):
        selected_user = self.user_combobox.get()
        if selected_user:
            self.update_history_table(selected_user)
            self.result_label.config(text="BMI: --", fg="#333333")
            self.category_label.config(text="Category: --", fg="#333333")

    def update_history_table(self, username):
        for row in self.tree.get_children():
            self.tree.delete(row)

        if not username:
            return

        records = self.db.get_history(username)
        for record in records:
            formatted_record = (
                record[0],
                f"{record[1]:.1f}",
                f"{record[2]:.2f}",
                f"{record[3]:.2f}",
                record[4]
            )
            self.tree.insert("", tk.END, values=formatted_record)

    @staticmethod
    def classify_bmi(bmi):
        # Use continuous boundaries so values such as 24.95 are not misclassified.
        if bmi < 18.5:
            return "Underweight", "#ffc107"
        elif bmi < 25:
            return "Normal", "#28a745"
        elif bmi < 30:
            return "Overweight", "#fd7e14"
        return "Obese", "#dc3545"

    def calculate_bmi(self):
        current_user = self.user_combobox.get()

        if not current_user:
            messagebox.showerror(
                "Input Error",
                "Please add or select a user profile first."
            )
            return

        weight_text = self.weight_entry.get().strip()
        height_text = self.height_entry.get().strip()

        if not weight_text or not height_text:
            messagebox.showerror(
                "Input Error",
                "Weight and height fields cannot be empty."
            )
            return

        try:
            weight = float(weight_text)
            height = float(height_text)

            if not math.isfinite(weight) or not math.isfinite(height):
                raise ValueError("Please enter finite numbers.")

            if weight <= 0 or height <= 0:
                raise ValueError("Weight and height must be greater than zero.")

        except ValueError as error:
            messagebox.showerror(
                "Invalid Input",
                f"Enter valid positive numeric values.\n{error}"
            )
            return

        bmi = weight / (height ** 2)

        if not math.isfinite(bmi):
            messagebox.showerror(
                "Calculation Error",
                "BMI could not be calculated from these values."
            )
            return

        bmi_rounded = round(bmi, 2)
        category, color = self.classify_bmi(bmi)

        self.result_label.config(
            text=f"BMI: {bmi_rounded:.2f}",
            fg=color
        )
        self.category_label.config(
            text=f"Category: {category}",
            fg=color
        )

        if self.db.save_record(
            current_user,
            weight,
            height,
            bmi_rounded,
            category
        ):
            self.update_history_table(current_user)

    def show_trend_graph(self):
        if not MATPLOTLIB_AVAILABLE:
            messagebox.showerror(
                "Missing Library",
                "Install Matplotlib with: pip install matplotlib"
            )
            return

        current_user = self.user_combobox.get()

        if not current_user:
            messagebox.showerror("Error", "Please select a user.")
            return

        records = self.db.get_history(current_user)

        if not records:
            messagebox.showinfo(
                "No Data",
                f"No BMI history found for {current_user}."
            )
            return

        try:
            dates = [record[0] for record in records]
            bmis = [record[3] for record in records]
            positions = list(range(1, len(bmis) + 1))

            plt.figure(figsize=(9, 5))
            plt.plot(
                positions,
                bmis,
                marker="o",
                linestyle="-",
                linewidth=2,
                label="BMI Trend"
            )

            plt.axhline(
                y=18.5,
                linestyle="--",
                label="Underweight boundary"
            )
            plt.axhline(
                y=25,
                linestyle="--",
                label="Normal upper boundary"
            )
            plt.axhline(
                y=30,
                linestyle="--",
                label="Obesity boundary"
            )

            plt.title(f"BMI Trend Over Time - {current_user}")
            plt.xlabel("Record")
            plt.ylabel("BMI")
            plt.xticks(
                positions,
                [date[:16] for date in dates],
                rotation=30,
                ha="right"
            )
            plt.grid(True)
            plt.legend()
            plt.tight_layout()
            plt.show()

        except Exception as error:
            messagebox.showerror(
                "Graph Error",
                f"Could not generate graph:\n{error}"
            )


if __name__ == "__main__":
    root = tk.Tk()
    app = AdvancedBMICalculatorApp(root)
    root.mainloop()
