from collections import deque
import string
import tkinter as tk
from tkinter import messagebox, ttk

# Import secrets for cryptographically secure generation
import secrets

# Import pyperclip for clipboard copy functionality
try:
    import pyperclip

    PYPERCLIP_AVAILABLE = True
except ImportError:
    PYPERCLIP_AVAILABLE = False


class AdvancedPasswordGeneratorApp:

  def __init__(self, root):
    self.root = root
    self.root.title("Advanced Secure Password Generator")
    self.root.geometry("480x620")
    self.root.minsize(450, 600)

    self.history = deque(maxlen=5)

    self.bg_color = "#f4f6f9"
    self.root.configure(bg=self.bg_color)

    self.create_widgets()

  def create_widgets(self):
    # Main Title
    title_label = tk.Label(
        self.root,
        text="Secure Password Generator",
        font=("Arial", 16, "bold"),
        bg=self.bg_color,
        fg="#333333",
    )
    title_label.pack(pady=10)

    config_frame = tk.LabelFrame(
        self.root,
        text=" Password Configuration ",
        font=("Arial", 10, "bold"),
        bg=self.bg_color,
        padx=15,
        pady=10,
    )
    config_frame.pack(fill="x", padx=20, pady=5)

    # Length Control (Spinbox: min 8 enforced)
    tk.Label(
        config_frame,
        text="Password Length (Min 8):",
        bg=self.bg_color,
        font=("Arial", 10),
    ).grid(row=0, column=0, sticky="w", pady=8)
    self.length_spinbox = ttk.Spinbox(
        config_frame, from_=8, to=128, width=10, font=("Arial", 10)
    )
    self.length_spinbox.set(12)  # Default strong length
    self.length_spinbox.grid(row=0, column=1, sticky="e", pady=8)

    # Character Type Checkboxes
    self.var_upper = tk.BooleanVar(value=True)
    self.var_lower = tk.BooleanVar(value=True)
    self.var_nums = tk.BooleanVar(value=True)
    self.var_symbols = tk.BooleanVar(value=True)
    self.var_ambiguous = tk.BooleanVar(
        value=False
    )  # Exclude ambiguous characters

    tk.Checkbutton(
        config_frame,
        text="Include Uppercase Letters (A-Z)",
        variable=self.var_upper,
        bg=self.bg_color,
        font=("Arial", 9),
    ).grid(row=1, column=0, columnspan=2, sticky="w", pady=2)
    tk.Checkbutton(
        config_frame,
        text="Include Lowercase Letters (a-z)",
        variable=self.var_lower,
        bg=self.bg_color,
        font=("Arial", 9),
    ).grid(row=2, column=0, columnspan=2, sticky="w", pady=2)
    tk.Checkbutton(
        config_frame,
        text="Include Numbers (0-9)",
        variable=self.var_nums,
        bg=self.bg_color,
        font=("Arial", 9),
    ).grid(row=3, column=0, columnspan=2, sticky="w", pady=2)
    tk.Checkbutton(
        config_frame,
        text="Include Symbols (!@#$...)",
        variable=self.var_symbols,
        bg=self.bg_color,
        font=("Arial", 9),
    ).grid(row=4, column=0, columnspan=2, sticky="w", pady=2)
    tk.Checkbutton(
        config_frame,
        text="Exclude Ambiguous Characters (e.g., 0, O, l, 1)",
        variable=self.var_ambiguous,
        bg=self.bg_color,
        font=("Arial", 9, "italic"),
        fg="#555555",
    ).grid(row=5, column=0, columnspan=2, sticky="w", pady=6)

    # Generate Button
    generate_btn = tk.Button(
        self.root,
        text="Generate Password",
        command=self.generate_password,
        bg="#28a745",
        fg="white",
        font=("Arial", 11, "bold"),
        pady=5,
    )
    generate_btn.pack(fill="x", padx=20, pady=10)

    # Output & Strength Frame
    output_frame = tk.LabelFrame(
        self.root,
        text=" Generated Password & Strength ",
        font=("Arial", 10, "bold"),
        bg=self.bg_color,
        padx=15,
        pady=10,
    )
    output_frame.pack(fill="x", padx=20, pady=5)

    # Password display entry
    self.password_entry = tk.Entry(
        output_frame, font=("Courier", 12, "bold"), width=26, justify="center"
    )
    self.password_entry.pack(fill="x", pady=5)

    # Copy Button
    copy_btn = tk.Button(
        output_frame,
        text="Copy to Clipboard",
        command=self.copy_to_clipboard,
        bg="#007bff",
        fg="white",
        font=("Arial", 9, "bold"),
    )
    copy_btn.pack(fill="x", pady=2)

    # Strength indicator label
    self.strength_label = tk.Label(
        output_frame,
        text="Strength: --",
        font=("Arial", 10, "bold"),
        bg=self.bg_color,
        fg="#666666",
    )
    self.strength_label.pack(anchor="w", pady=5)

    # History Frame (Last 5 generated passwords in session)
    history_frame = tk.LabelFrame(
        self.root,
        text=" Session History (Last 5) ",
        font=("Arial", 10, "bold"),
        bg=self.bg_color,
        padx=10,
        pady=10,
    )
    history_frame.pack(fill="both", expand=True, padx=20, pady=10)

    columns = ("Password",)
    self.history_tree = ttk.Treeview(
        history_frame, columns=columns, show="headings", height=4
    )
    self.history_tree.heading("Password", text="Recent Passwords")
    self.history_tree.column("Password", width=380, anchor="w")
    self.history_tree.pack(fill="both", expand=True)

  def generate_password(self):
    # 1. Input Validation: Check Length
    try:
      length = int(self.length_spinbox.get())
      if length < 8:
        raise ValueError("Minimum length is 8 characters.")
    except ValueError as e:
      messagebox.showerror(
          "Invalid Input",
          f"Please specify a valid numeric length (at least 8).\n({e})",
      )
      return

    # 2. Character type selection validation (at least 2 types must be selected)
    use_upper = self.var_upper.get()
    use_lower = self.var_lower.get()
    use_nums = self.var_nums.get()
    use_symbols = self.var_symbols.get()

    selected_types_count = sum(
        [use_upper, use_lower, use_nums, use_symbols]
    )
    if selected_types_count < 2:
      messagebox.showerror(
          "Validation Error",
          "You must select at least 2 character types to ensure security.",
      )
      return

    # Build character pools based on selections and exclusions
    upper_pool = string.ascii_uppercase
    lower_pool = string.ascii_lowercase
    num_pool = string.digits
    symbol_pool = "!@#$%^&*()_+-=[]{}|;:,.<>?"

    if self.var_ambiguous.get():
      # Exclude ambiguous characters: 0, O, l, 1, I
      ambiguous_chars = "0OIl1"
      upper_pool = "".join(
          c for c in upper_pool if c not in ambiguous_chars
      )
      lower_pool = "".join(
          c for c in lower_pool if c not in ambiguous_chars
      )
      num_pool = "".join(c for c in num_pool if c not in ambiguous_chars)

    # Security Rule: Guaranteed to contain at least one character from each selected type
    password_chars = []
    pool_collection = []

    if use_upper and upper_pool:
      password_chars.append(secrets.choice(upper_pool))
      pool_collection.append(upper_pool)
    if use_lower and lower_pool:
      password_chars.append(secrets.choice(lower_pool))
      pool_collection.append(lower_pool)
    if use_nums and num_pool:
      password_chars.append(secrets.choice(num_pool))
      pool_collection.append(num_pool)
    if use_symbols and symbol_pool:
      password_chars.append(secrets.choice(symbol_pool))
      pool_collection.append(symbol_pool)

    # Combine all selected pools for filling the rest of the length
    full_pool = "".join(pool_collection)
    if not full_pool:
      messagebox.showerror(
          "Error",
          "Selected character pools are empty due to ambiguity filtering.",
      )
      return

    # Fill remaining characters securely using secrets module
    remaining_length = length - len(password_chars)
    for _ in range(remaining_length):
      password_chars.append(secrets.choice(full_pool))

    # Shuffle cryptographically to avoid predictable character ordering
    secrets.SystemRandom().shuffle(password_chars)
    generated_password = "".join(password_chars)

    # Display generated password in entry
    self.password_entry.delete(0, tk.END)
    self.password_entry.insert(0, generated_password)

    # Automatically copy to clipboard
    self.copy_to_clipboard(silent=True)

    # Evaluate and display strength indicator
    self.evaluate_strength(length, selected_types_count)

    # Update session history (store last 5)
    self.history.appendleft(generated_password)
    self.update_history_display()

  def evaluate_strength(self, length, type_count):
    # Logic for determining Weak / Medium / Strong
    if length >= 16 and type_count >= 3:
      strength = "Strong 🔒"
      color = "#28a745"  # Green
    elif length >= 12 and type_count >= 2:
      strength = "Medium ⚠️"
      color = "#fd7e14"  # Orange
    else:
      strength = "Weak ❌"
      color = "#dc3545"  # Red

    self.strength_label.config(text=f"Strength: {strength}", fg=color)

  def copy_to_clipboard(self, silent=False):
    pwd = self.password_entry.get()
    if not pwd:
      if not silent:
        messagebox.showwarning("Warning", "No password generated to copy.")
      return

    if PYPERCLIP_AVAILABLE:
      pyperclip.copy(pwd)
      if not silent:
        messagebox.showinfo(
            "Success", "Password copied to clipboard automatically!"
        )
    else:
      if not silent:
        messagebox.showerror(
            "Clipboard Error",
            "pyperclip module not found. Install via 'pip install pyperclip'.",
        )

  def update_history_display(self):
    for row in self.history_tree.get_children():
      self.history_tree.delete(row)
    for pwd in self.history:
      self.history_tree.insert("", tk.END, values=(pwd,))


if __name__ == "__main__":
  root = tk.Tk()
  app = AdvancedPasswordGeneratorApp(root)
  root.mainloop()